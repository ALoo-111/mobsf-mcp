# MobSF backend
MOBSF_URL=https://mobsf.live
MOBSF_API_KEY=
MOBSF_TIMEOUT=300
MOBSF_VERIFY_TLS=true

# MCP server
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8001

# Input and response safety
MAX_APK_SIZE_MB=500
MAX_RESPONSE_BYTES=52428800
SOURCE_CONTEXT_LINES=3
MAX_SOURCE_BYTES=65536

# Optional dynamic analysis
ENABLE_DYNAMIC_ANALYSIS=false
DYNAMIC_ANALYSIS_TIMEOUT=600
